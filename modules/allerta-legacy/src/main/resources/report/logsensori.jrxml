	<queryString>
		<![CDATA[select st.name as stazione, case when l.idvariabile like '%B13215' then 'Idrometro' else 'Pluviometro' end as variabile, data_disattivazione as ts, case when disattivazione then
'Disattivazione' else 'Attivazione' end as disattivazione, o.descrizione as motivazione from bollettino_log_sensori l join bollettino_stazione st on l.idstazione=st.id_ left
join bollettino_opzioni_log_sensori o on l.motivazione=o.idopzione]]>
	</queryString>
