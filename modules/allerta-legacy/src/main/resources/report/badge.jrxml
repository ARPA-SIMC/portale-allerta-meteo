	</parameter>
	<queryString>
		<![CDATA[select * from api_requests
where ($P{DATADA} is null or $P{DATADA}='' or $P{DATADA}<=data::character varying) AND
 ($P{DATAA} is null or $P{DATAA}='' or $P{DATAA}>=data::character varying) AND
($P{TEMPL} is null or $P{TEMPL}='' or tipo like '%' || lower($P{TEMPL}) || '%') AND
($P{DOMINIO} is null or $P{DOMINIO}='' or dominio like '%' || lower($P{DOMINIO}) || '%')
 order by data asc, dominio, tipo]]>
	</queryString>
	<field name="dominio" class="java.lang.String"/>
	<field name="tipo" class="java.lang.String"/>
	<field name="data" class="java.sql.Date"/>
	<field name="accessi" class="java.lang.Long"/>
