	</parameter>
	<parameter name="DATADA" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="DATAA" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select * from allerter_invii where 1=1 and ($P{DATADA} is null or $P{DATADA}='' or creazione>=cast($P{DATADA} as timestamp without time zone))
 and ($P{DATAA} is null or $P{DATAA}='' or creazione<=cast($P{DATAA} as timestamp without time zone))
and ($P{FILTRO} is null or $P{FILTRO}=''
or upper(evento) like concat('%',upper($P{FILTRO}),'%')
or upper(tipo_evento) like concat('%',upper($P{FILTRO}),'%'))]]>
	</queryString>
