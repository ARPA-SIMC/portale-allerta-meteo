Bundle-Name: allerta-rubrica-web
Bundle-SymbolicName: allerta.rubrica.web
Bundle-Version: 1.0.0
Export-Package: allerta.rubrica.web.constants
Provide-Capability:\
	liferay.language.resources;\
		resource.bundle.base.name="content.Language"
-fixupmessages "Classes found in the wrong directory"; restrict:=error; is:=warning
Import-Package: \
!com.sun.*,\
!junit.framework.*,\
!org.junit.*,\
!org.apache.*,\
!org.bouncycastle.*,\
!org.etsi.*,\
*